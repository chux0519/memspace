# Build this executable from the MemSpace commit disclosed with the results.
MEMSPACE_WORKER=/absolute/path/to/omnimemeval-worker
# Dedicated new root only. Never use the production DB or agent home directories.
MEMSPACE_DB_ROOT=/absolute/path/to/private-evaluation-root
MEMSPACE_MODE=context_pack
# Default off; shadow captures only; on enables experimental evidence groups.
MEMSPACE_EVIDENCE_MODE=off
MEMSPACE_EVIDENCE_MAX_RELATED=24
MEMSPACE_EMBEDDING_URL=http://127.0.0.1:18792/v1/embeddings
MEMSPACE_EMBED_MODEL=BAAI/bge-m3
MEMSPACE_RPC_TIMEOUT=900
ANSWER_MODEL=gpt-4.1-mini-2025-04-14
ANSWER_API_KEY=
ANSWER_BASE_URL=https://api.openai.com/v1
EVAL_MODEL=gpt-4o-mini-2024-07-18
EVAL_API_KEY=
EVAL_BASE_URL=https://api.openai.com/v1
